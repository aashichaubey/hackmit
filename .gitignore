data/raw/
data/processed/
data/cache/
experiments/results/
!data/raw/.gitkeep
!data/processed/.gitkeep
!experiments/results/.gitkeep

# keep small committed example dictionaries
!data/dictionaries/

# --- models / hf cache ---
.hf_cache/
*.safetensors
*.bin

# --- os ---
.DS_Store
