# --- secrets (NEVER commit) ---
.env
.env.local
*.key

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- eval run artifacts (regenerable; may contain full prompts) ---
evals/**/runs/

