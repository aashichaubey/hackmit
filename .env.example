# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenRouter: used for the LLM judge (semantic equivalence) and task-performance evals.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: direct provider keys, if you want to bypass OpenRouter.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: HuggingFace token (only needed for gated repos; the default
# tokenizer + embedding models used here are public).
# HF_TOKEN=

# Where to cache downloaded models/tokenizers.
HF_HOME=.hf_cache
