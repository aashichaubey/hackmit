# Use "mock" for a free pipeline smoke test, or "openai" for the real experiment.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
GENERATION_MODEL=gpt-4.1-mini
ANSWER_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-mini
TARGET_MODEL=gpt-4.1-mini
# Optional explicit tiktoken encoding (otherwise inferred from TARGET_MODEL).
TOKENIZER_ENCODING=
GENERATION_TEMPERATURE=0
TOKEN_SEARCH_TEMPERATURE=0.8

# Tokenmix / meeting-note pruning API experiments.
OPENROUTER_API_KEY=
TTC_API_KEY=
